{
  "permissions": {
    "allow": [
      "Bash(git remote *)",
      "Bash(git checkout *)",
      "Bash(git push *)",
      "Bash(git ls-remote *)",
      "Bash(ls *)",
      "Bash(git pull *)"
      
    ],
  "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/tool_call.js",
            "statusMessage": "Logging tool call"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e 'let s=\"\";process.stdin.on(\"data\",d=>s+=d).on(\"end\",()=>{try{const j=JSON.parse(s);process.stdout.write((j.tool_response&&j.tool_response.filePath)||(j.tool_input&&j.tool_input.file_path)||\"\")}catch(e){}})' | { read -r f; [ -n \"$f\" ] || exit 0; case \"$f\" in *[Ff]rontend*) frontend/node_modules/.bin/prettier --write --ignore-unknown \"$f\" ;; esac; } 2>/dev/null || true",
            "statusMessage": "Formatting with Prettier"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          
          {
            "type": "command",
            "command": "node .claude/hooks/teammate_idle_escalation.js",
            "async": true,
            "statusMessage": "Teammate idle — escalation timer (20s)"
          }
        ]
      }
    ]
  }
}
